{
  "name": "svg-diagram-vscode",
  "displayName": "svg-diagram",
  "description": "svg-diagram の図のソースを VS Code で書く・検査する・プレビューする",
  "version": "0.0.1",
  "publisher": "cuzic",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuzic/svg-diagram-vscode.git"
  },
  "engines": {
    "vscode": "^1.100.0",
    "node": ">=22.18"
  },
  "categories": [
    "Visualization",
    "Linters"
  ],
  "main": "./dist/extension.cjs",
  "activationEvents": [
    "workspaceContains:node_modules/svg-diagram/package.json",
    "workspaceContains:**/.svg-diagram.json",
    "onLanguage:typescript",
    "onLanguage:javascript",
    "onWebviewPanel:svgDiagram.preview"
  ],
  "contributes": {
    "commands": [
      {
        "command": "svgDiagram.showOutput",
        "title": "出力ログを開く",
        "category": "svg-diagram"
      },
      {
        "command": "svgDiagram.showCli",
        "title": "使う CLI の場所と版を表示",
        "category": "svg-diagram"
      },
      {
        "command": "svgDiagram.checkFile",
        "title": "この図を検査",
        "category": "svg-diagram"
      },
      {
        "command": "svgDiagram.checkWorkspace",
        "title": "ワークスペースの図をすべて検査",
        "category": "svg-diagram"
      },
      {
        "command": "svgDiagram.openPreview",
        "title": "プレビューを横に開く",
        "category": "svg-diagram",
        "icon": "$(open-preview)"
      },
      {
        "command": "svgDiagram.showPreview",
        "title": "プレビューを開く",
        "category": "svg-diagram"
      },
      {
        "command": "svgDiagram.menu",
        "title": "メニュー",
        "category": "svg-diagram"
      },
      {
        "command": "svgDiagram.typecheck",
        "title": "型検査（typecheck）",
        "category": "svg-diagram"
      },
      {
        "command": "svgDiagram.setup",
        "title": "この案件で svg-diagram を使えるようにする",
        "category": "svg-diagram"
      }
    ],
    "configuration": {
      "title": "svg-diagram",
      "properties": {
        "svgDiagram.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine-overridable",
          "markdownDescription": "svg-diagram の CLI（`bin/svg-diagram`）の場所。空なら、案件の `node_modules/svg-diagram`、次に `PATH` を探す。相対パスはワークスペースのフォルダから、`~` はホーム。手元の core を試すときは `../svg-diagram/bin/svg-diagram` のように向ける。"
        },
        "svgDiagram.check.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "`svg-diagram check` の所見を「問題」パネルに出す。"
        },
        "svgDiagram.check.onSave": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "図のソース（`from 'svg-diagram'` を import している `.ts` / `.mts` / `.js` / `.mjs`）を保存したときに検査する。"
        },
        "svgDiagram.check.onOpen": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "図のソースを開いたときに検査する（まだ所見がないとき）。"
        }
      }
    },
    "menus": {
      "explorer/context": [
        {
          "command": "svgDiagram.checkFile",
          "when": "resourceExtname =~ /\\.(m?ts|m?js)$/",
          "group": "svg-diagram"
        },
        {
          "command": "svgDiagram.openPreview",
          "when": "resourceExtname =~ /\\.(m?ts|m?js)$/",
          "group": "svg-diagram"
        }
      ],
      "commandPalette": [
        {
          "command": "svgDiagram.checkFile",
          "when": "editorLangId =~ /^(typescript|javascript)$/"
        },
        {
          "command": "svgDiagram.openPreview",
          "when": "svgDiagram.isSource"
        },
        {
          "command": "svgDiagram.showPreview",
          "when": "svgDiagram.isSource"
        }
      ],
      "editor/title": [
        {
          "command": "svgDiagram.openPreview",
          "when": "svgDiagram.isSource",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "svgDiagram.openPreview",
        "key": "ctrl+k v",
        "mac": "cmd+k v",
        "when": "svgDiagram.isSource && editorTextFocus"
      }
    ],
    "taskDefinitions": [
      {
        "type": "svg-diagram",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "typecheck"
            ],
            "description": "svg-diagram のサブコマンド"
          },
          "args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "続けて渡す引数"
          }
        }
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "watch": "node scripts/build.ts --watch",
    "typecheck": "tsc -p .",
    "lint": "biome lint .",
    "test": "node --test \"test/unit/*.test.ts\"",
    "test:integration": "node scripts/build.ts --tests && vscode-test",
    "package": "pnpm build --production && vsce package --no-dependencies",
    "vscode:prepublish": "pnpm build --production"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.18.0",
    "@types/vscode": "~1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "案件の node_modules にある svg-diagram の CLI を実行するので、信頼したワークスペースでだけ動く。"
    },
    "virtualWorkspaces": false
  }
}
