{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"playwright.config.ts",
			"e2e/**",
			"src/**",
			"scripts/**",
			"test/**",
			"*.mjs",
			"!test/fixtures"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"correctness": {
				"noUnusedImports": "error",
				"noUnusedVariables": "error",
				"noUnusedFunctionParameters": "error"
			},
			"style": {
				"useImportType": "error",
				"noNonNullAssertion": "error",
				"useTemplate": "off"
			},
			"suspicious": {
				"noExplicitAny": "error"
			},
			"complexity": {
				"useLiteralKeys": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": [
				"e2e/**"
			],
			"linter": {
				"rules": {
					"correctness": {
						"noEmptyPattern": "off"
					}
				}
			}
		}
	]
}
